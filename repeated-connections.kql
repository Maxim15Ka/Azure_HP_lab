// Scheduled rule: frequency 5m, lookback 5m, result threshold > 0.
Cowrie_CL
| where TimeGenerated > ago(5m)
| where eventid == "cowrie.session.connect"
| where isnotempty(src_ip)
| where src_ip !in ("127.0.0.1", "::1")
| summarize ConnectionCount = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated) by src_ip
| where ConnectionCount >= 20
